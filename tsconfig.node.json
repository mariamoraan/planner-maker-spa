{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],

    /* These run on Node as ESM (package.json "type": "module"), so relative
       imports must carry an explicit .js extension. NodeNext enforces that at
       compile time; "bundler" silently allowed extensionless imports that then
       failed at runtime on Vercel with ERR_MODULE_NOT_FOUND. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vite.dev-api-plugin.ts", "server/**/*.ts", "api/**/*.ts"]
}
