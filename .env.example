# Firebase (required for auth, waitlist, analytics)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Infrastructure provider (firebase | future alternatives)
VITE_INFRA_PROVIDER=firebase

# Image storage: local | cloud (Uploadthing)
VITE_IMAGE_STORAGE=cloud

# Optional overrides for local dev (defaults to same origin with npm run dev)
# VITE_UPLOADTHING_URL=http://localhost:8080/api/uploadthing
# VITE_IMAGE_DELETE_URL=http://localhost:8080/api/images/delete

# Uploadthing (server-only — set in Vercel Environment Variables)
UPLOADTHING_TOKEN=

# Firebase Admin (server-only) — pick ONE option:
# Option A (recommended): path to the JSON key downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-admin-key.json
# Option B: full JSON on one line wrapped in single quotes
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'
